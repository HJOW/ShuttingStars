{
  "hosting": {
    "public": "src/main/webapp",
    "ignore": [
      "firebase.json",
      "**/.*",
	    "**/WEB-INF/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers" : [
      {
        "source" : "**",
        "headers" : [
          {
            "key" : "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, POST"
          }
        ]
      }
    ]
  }
}
